// client/tsconfig.app.json — production app code only (client/src/**), browser
// environment. Used by `vite build`/`vite dev` and the IDE's default project
// (referenced from client/tsconfig.json). Deliberately excludes `node` types
// and client/tests/** — see tsconfig.test.json for the config that covers
// both.
{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ESNext", "DOM"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
