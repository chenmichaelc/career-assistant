{
  "name": "career-assistant",
  "version": "1.0.0",
  "description": "Local job search state management and career tooling.",
  "main": "index.js",
  "scripts": {
    "client": "cd client && npm run dev",
    "client:host": "cd client && npm run dev -- --host",
    "format": "prettier --write .",
    "init": "ts-node scripts/init-db.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "server": "ts-node server/index.ts",
    "test": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "test:run": "vitest --run"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "better-sqlite3": "^12.10.0",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@vitest/eslint-plugin": "^1.6.20",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{ts,mts,vue,js,json,md}": "prettier --write"
  }
}
